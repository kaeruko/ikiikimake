# Local Python/runtime state
__pycache__/
.venv/

# Local source videos and large datasets
*.mp4
datasets/
cheek01_frames/
cheek01_candidates/

# Local ML models / checkpoints
models/*.task
models/makeup_transfer*/
*.pt
*.pth

# Heavy generated intermediates.
# Keep human-review artifacts (PNG/HTML/CSV/small JSON) trackable so analysis
# results can be reviewed directly in GitHub.
outputs/roi_debug/
outputs/makeup_transfer*/
outputs/**/frames/
outputs/**/rois/
outputs/**/frames.jsonl
outputs/**/*.npz
outputs/**/scan_manifest.json

# Selected-region analysis keeps one stable latest result set in the root.
# Ignore legacy/future fingerprint subdirectories so reports do not proliferate.
outputs/**/selected_region_analysis/*/

# Optional explicit review-export directory remains trackable.
!review_exports/
!review_exports/**
